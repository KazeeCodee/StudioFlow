# Guardas obligatorias: copiá este archivo a .env.e2e.local y usá sólo staging.
E2E_ALLOW_MUTATIONS=false
E2E_EXPECTED_SUPABASE_PROJECT_REF=staging-project-ref
E2E_PRODUCTION_SUPABASE_PROJECT_REF=production-project-ref
E2E_BASE_URL=http://127.0.0.1:3000

NEXT_PUBLIC_SUPABASE_URL=https://staging-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=staging-anon-key
SUPABASE_SERVICE_ROLE_KEY=staging-service-role-key
DATABASE_URL=postgresql://postgres.staging-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_POOL_MAX=1

APP_URL=http://127.0.0.1:3000
CRON_SECRET=local-e2e-cron-secret
REDIS_URL=redis://127.0.0.1:6380
EMAIL_TRANSPORT_MODE=log
CSP_REPORT_ONLY=true
USE_NEXT_RSPACK=false
